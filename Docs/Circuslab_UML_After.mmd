                ORM["Flask-SQLAlchemy / PyMySQL<br/>Application models"]
                UI["Jinja templates<br/>CSS · avatar assets"]
            end

            MySQL[("MySQL 8.4<br/>db:3306")]
        end

        Volume[("mysql_data<br/>persistent volume")]
    end

    External["External services<br/>MusicBrainz API · Cover Art Archive"]

    User --> Browser
